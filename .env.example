# Endpoint que recebe os formulários (orçamento e contato).
# Funciona com serviços como Web3Forms, Formspree ou Getform — basta criar
# uma conta gratuita, copiar a URL de envio e colar aqui.
# Enquanto isso não for configurado, os formulários caem automaticamente
# no fallback de WhatsApp (ver src/data/site.ts).
NEXT_PUBLIC_FORM_ENDPOINT=
